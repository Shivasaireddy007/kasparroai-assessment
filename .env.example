# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://localhost:5432/claimcheck
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Provider tuning (kept fixed across v1/v2 and all runs)
LLM_THINKING_LEVEL=
# Minimum seconds between provider request starts (free-tier per-minute quota). 0 disables.
LLM_MIN_INTERVAL_S=6
TEST_DATABASE_URL=postgresql://localhost:5432/claimcheck_test
